{
  "name": "bowling",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.11"
  },
  "workspaces": [
    "models",
    "game",
    "storybook"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "npm run dev -w game",
    "storybook": "npm run storybook -w storybook",
    "test": "npm run test --workspaces",
    "test:scripts": "node --test \"scripts/tests/*.test.mjs\"",
    "gates": "node scripts/run-gates.mjs",
    "gates:selftest": "node scripts/run-gates.mjs --selftest",
    "check": "npm test && npm run test:scripts && npm run gates && npm run gates:selftest && npm run wiki:lint && npm run wiki:selftest",
    "check:full": "npm run check && node scripts/run-gates.mjs --full",
    "shot": "node scripts/shot/shot.mjs",
    "pilot": "node scripts/not-built.mjs pilot/headless-runs.md",
    "bake:tracks": "TSX_TSCONFIG_PATH=game/tsconfig.json node --import tsx scripts/tracks/bake.mjs",
    "wiki:lint": "node scripts/wiki/lint.mjs",
    "wiki:index": "node scripts/wiki/index.mjs",
    "wiki:context": "node scripts/wiki/context.mjs",
    "wiki:touched": "node scripts/wiki/touched.mjs",
    "acceptance:lock": "node scripts/wiki/acceptance-lock.mjs",
    "stats": "node scripts/stats/stats.mjs",
    "audio:build": "TSX_TSCONFIG_PATH=game/tsconfig.json node --import tsx scripts/audio/generate.mjs",
    "audio:check": "TSX_TSCONFIG_PATH=game/tsconfig.json node --import tsx scripts/gates/check-audio.mjs",
    "wiki:selftest": "node scripts/wiki/lint.mjs --selftest && node scripts/wiki/index.mjs --selftest && node scripts/wiki/check-acceptance.mjs --selftest && node scripts/wiki/agents-lint.mjs --selftest && node scripts/wiki/context.mjs --selftest && node scripts/wiki/touched.mjs --selftest && node scripts/wiki/acceptance-lock.mjs --selftest",
    "shot:verify": "node scripts/shot/verify.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
